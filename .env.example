# Synthetic LOCAL demonstration only. Docker Compose reads this file when copied to .env.
DEMO_PASSWORD=ClinicalSync-demo-2026!
SHARED_DB_PASSWORD=synthetic-shared-local-only
NORTHSTAR_DB_PASSWORD=synthetic-northstar-local-only
RIVERSIDE_DB_PASSWORD=synthetic-riverside-local-only
DEMO_MODE=true
SECURE_COOKIE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Documentation providers: the local development workflow needs no external credentials.
TRANSCRIPTION_PROVIDER=manual
NOTE_GENERATION_PROVIDER=local
AI_EXTERNAL_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
NOTE_MODEL=gpt-4.1-mini
# Audio is never persisted server-side. Set retention to 0 to avoid persisting transcripts.
TRANSCRIPT_RETENTION_DAYS=7
AUDIO_MAX_BYTES=15728640
# Optional additional hospitals (JSON, local launcher; see docs/ARCHITECTURE.md):
# HOSPITAL_CONFIG_JSON={}
# Optional Python-only overrides (Compose supplies its own PostgreSQL URLs):
# SHARED_DATABASE_URL=sqlite:///.data/clinicalsync_shared.db
# HOSPITAL_A_DATABASE_URL=sqlite:///.data/clinicalsync_northstar.db
# HOSPITAL_B_DATABASE_URL=sqlite:///.data/clinicalsync_riverside.db
